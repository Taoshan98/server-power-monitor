# Server Power Monitor Configuration (Rust Edition)
# Copy this file to /etc/server-power-monitor.conf or keep it here as server-power-monitor.conf

# Sampling interval in seconds
SAMPLE_INTERVAL=5

# Electricity tariff and currency
TARIFF_EUR_KWH=0.30
CURRENCY="EUR"

# Label to identify the machine in reports
HOST_LABEL="$(hostname)"

# Daily report schedule (24h)
REPORT_HOUR=23
REPORT_MINUTE=55

# Telegram Integration
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Intermediate report interval (in hours)
# Example: 1 = every hour, 6 = every 6 hours, 0 = disabled
TELEGRAM_REPORT_INTERVAL_HOURS=6

# Power Peak Telegram Alert threshold in Watts (0 = disabled)
# Example: MAX_POWER_ALERT_WATTS=300
MAX_POWER_ALERT_WATTS=0

# Retention Policy for historical state files in days (0 = keep forever)
RETENTION_DAYS=365

# Automatic CSV Export of daily energy reports (1 = enabled, 0 = disabled)
CSV_EXPORT_ENABLED=1
