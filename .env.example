# Server Power Monitor Configuration (.env format)
# Rename this file to .env or server-power-monitor.env
# You can also pass these variables directly in docker-compose.yml under environment:

SAMPLE_INTERVAL=5
TARIFF_EUR_KWH=0.30
CURRENCY="EUR"
HOST_LABEL="$(hostname)"

# Telegram Integration
TELEGRAM_ENABLED=0
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_REPORT_INTERVAL_HOURS=6
REPORT_HOUR=23
REPORT_MINUTE=55

# Retention & Alerts
RETENTION_DAYS=365
MAX_POWER_ALERT_WATTS=0
CSV_EXPORT_ENABLED=1

# MQTT Integration for Home Assistant Auto-Discovery
MQTT_ENABLED=0
MQTT_HOST="localhost"
MQTT_PORT=1883
MQTT_USERNAME=""
MQTT_PASSWORD=""
MQTT_TOPIC_PREFIX="server-power-monitor"

# Encrypted P2P Cluster Mesh Network (ChaCha20-Poly1305 Ciphers)
P2P_ENABLED=0
CLUSTER_SECRET=""
P2P_PORT=7432
P2P_PEERS=""
